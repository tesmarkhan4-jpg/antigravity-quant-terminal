# ==========================================================================
# ANTIGRAVITY QUANT AI - CLOUD ENVIRONMENT CONFIGURATION
# Copy this file to .env locally or paste these variables into your Cloud Dashboard
# ==========================================================================

# AI Brain API Keys (Optional - Terminal operates high-predictability rules autonomously without these)
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Binance Exchange Bridge (Optional - Leave blank for Simulated Paper Trading Mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading Mode: SIMULATED_PAPER or BINANCE_LIVE
TRADING_MODE=SIMULATED_PAPER

# Cloud Deployment Port (Render / Koyeb / Railway will automatically assign this)
PORT=8500
